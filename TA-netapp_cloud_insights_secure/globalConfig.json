{
    "pages": {
        "configuration": {
            "title": "Configuration",
            "description": "Configure VeeOne API accounts, proxy and logging for the add-on.",
            "tabs": [
                {
                    "name": "account",
                    "title": "Accounts",
                    "restHandlerModule": "cloud_secure_account_handler",
                    "restHandlerClass": "CloudSecureAccountHandler",
                    "table": {
                        "actions": [
                            "edit",
                            "delete",
                            "clone"
                        ],
                        "header": [
                            {
                                "label": "Name",
                                "field": "name"
                            },
                            {
                                "label": "Tenant URL",
                                "field": "tenant_url"
                            }
                        ]
                    },
                    "entity": [
                        {
                            "type": "text",
                            "label": "Account Name",
                            "field": "name",
                            "help": "A unique name for this Cloud Insights tenant connection.",
                            "required": true,
                            "validators": [
                                {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 50,
                                    "errorMsg": "Length of Account Name should be between 1 and 50."
                                },
                                {
                                    "type": "regex",
                                    "pattern": "^[a-zA-Z]\\w*$",
                                    "errorMsg": "Name must begin with a letter and contain only letters, numbers and underscores."
                                }
                            ]
                        },
                        {
                            "type": "text",
                            "label": "Tenant URL",
                            "field": "tenant_url",
                            "required": true,
                            "help": "Your Data Infrastructure Insights (Cloud Insights) tenant, e.g. https://xyzcorp.c01.cloudinsights.netapp.com. A full API URL such as .../rest/v1/cloudsecure/alerts is also accepted.",
                            "validators": [
                                {
                                    "type": "regex",
                                    "pattern": "^(https://)?[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)+(:\\d{1,5})?(/rest/[A-Za-z0-9/_.-]*)?/?$",
                                    "errorMsg": "Enter the HTTPS tenant URL, for example https://xyzcorp.c01.cloudinsights.netapp.com"
                                },
                                {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 255,
                                    "errorMsg": "Length of Tenant URL should be between 1 and 255."
                                }
                            ]
                        },
                        {
                            "type": "text",
                            "label": "API Access Token",
                            "field": "api_key",
                            "required": true,
                            "encrypted": true,
                            "help": "Workload Security API access token (Admin > API Access), sent as the X-CloudInsights-ApiKey header. Stored encrypted in Splunk's credential store.",
                            "validators": [
                                {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 8192,
                                    "errorMsg": "Length of API Access Token should be between 1 and 8192."
                                }
                            ]
                        }
                    ]
                },
                {
                    "name": "proxy",
                    "title": "Proxy",
                    "entity": [
                        {
                            "type": "checkbox",
                            "label": "Enable",
                            "field": "proxy_enabled"
                        },
                        {
                            "type": "singleSelect",
                            "label": "Proxy Type",
                            "field": "proxy_type",
                            "defaultValue": "http",
                            "options": {
                                "disableSearch": true,
                                "autoCompleteFields": [
                                    {
                                        "value": "http",
                                        "label": "http"
                                    },
                                    {
                                        "value": "socks5",
                                        "label": "socks5"
                                    }
                                ]
                            },
                            "validators": [
                                {
                                    "type": "regex",
                                    "pattern": "^(http|socks5)$",
                                    "errorMsg": "Proxy Type must be http or socks5."
                                }
                            ]
                        },
                        {
                            "type": "text",
                            "label": "Host",
                            "field": "proxy_url",
                            "validators": [
                                {
                                    "type": "string",
                                    "minLength": 0,
                                    "maxLength": 4096,
                                    "errorMsg": "Max host length is 4096"
                                },
                                {
                                    "type": "regex",
                                    "pattern": "^[A-Za-z0-9.:\\-\\[\\]]*$",
                                    "errorMsg": "Enter a host name or IP address only, without scheme."
                                }
                            ]
                        },
                        {
                            "type": "text",
                            "label": "Port",
                            "field": "proxy_port",
                            "validators": [
                                {
                                    "type": "number",
                                    "range": [
                                        1,
                                        65535
                                    ],
                                    "isInteger": true
                                }
                            ]
                        },
                        {
                            "type": "text",
                            "label": "Username",
                            "field": "proxy_username",
                            "validators": [
                                {
                                    "type": "string",
                                    "minLength": 0,
                                    "maxLength": 50,
                                    "errorMsg": "Max length of username is 50"
                                }
                            ]
                        },
                        {
                            "type": "text",
                            "label": "Password",
                            "field": "proxy_password",
                            "encrypted": true,
                            "validators": [
                                {
                                    "type": "string",
                                    "minLength": 0,
                                    "maxLength": 8192,
                                    "errorMsg": "Max length of password is 8192"
                                }
                            ]
                        },
                        {
                            "type": "checkbox",
                            "label": "Reverse DNS resolution (socks5)",
                            "field": "proxy_rdns"
                        }
                    ],
                    "options": {
                        "saveValidator": "function(formData) { if(!formData.proxy_enabled || formData.proxy_enabled === '0') {return true; } if(!formData.proxy_url) { return 'Proxy Host can not be empty'; } if(!formData.proxy_port) { return 'Proxy Port can not be empty'; } return true; }"
                    }
                },
                {
                    "name": "logging",
                    "title": "Logging",
                    "entity": [
                        {
                            "type": "singleSelect",
                            "label": "Log level",
                            "field": "loglevel",
                            "defaultValue": "INFO",
                            "options": {
                                "disableSearch": true,
                                "autoCompleteFields": [
                                    {
                                        "value": "DEBUG",
                                        "label": "DEBUG"
                                    },
                                    {
                                        "value": "INFO",
                                        "label": "INFO"
                                    },
                                    {
                                        "value": "WARNING",
                                        "label": "WARNING"
                                    },
                                    {
                                        "value": "ERROR",
                                        "label": "ERROR"
                                    },
                                    {
                                        "value": "CRITICAL",
                                        "label": "CRITICAL"
                                    }
                                ]
                            },
                            "validators": [
                                {
                                    "type": "regex",
                                    "pattern": "^(DEBUG|INFO|WARNING|ERROR|CRITICAL)$",
                                    "errorMsg": "Select a valid log level."
                                }
                            ],
                            "required": true
                        }
                    ]
                }
            ]
        },
        "inputs": {
            "title": "Inputs",
            "description": "Collect Workload Security (Cloud Secure) alerts.",
            "table": {
                "actions": [
                    "edit",
                    "delete",
                    "clone"
                ],
                "header": [
                    {
                        "label": "Name",
                        "field": "name"
                    },
                    {
                        "label": "Account",
                        "field": "account"
                    },
                    {
                        "label": "Interval (s)",
                        "field": "interval"
                    },
                    {
                        "label": "Index",
                        "field": "index"
                    },
                    {
                        "label": "Status",
                        "field": "disabled"
                    }
                ],
                "moreInfo": [
                    {
                        "label": "Name",
                        "field": "name"
                    },
                    {
                        "label": "Account",
                        "field": "account"
                    },
                    {
                        "label": "Interval (s)",
                        "field": "interval"
                    },
                    {
                        "label": "Index",
                        "field": "index"
                    },
                    {
                        "label": "Status",
                        "field": "disabled",
                        "mapping": {
                            "true": "Disabled",
                            "false": "Enabled"
                        }
                    }
                ]
            },
            "services": [
                {
                    "name": "cloud_secure_alerts",
                    "title": "Cloud Secure Alerts",
                    "entity": [
                        {
                            "type": "text",
                            "label": "Name",
                            "field": "name",
                            "help": "A unique name for this input.",
                            "required": true,
                            "validators": [
                                {
                                    "type": "regex",
                                    "pattern": "^[a-zA-Z]\\w*$",
                                    "errorMsg": "Name must begin with a letter and contain only letters, numbers and underscores."
                                },
                                {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 100,
                                    "errorMsg": "Length of input name should be between 1 and 100"
                                }
                            ]
                        },
                        {
                            "type": "singleSelect",
                            "label": "Account",
                            "field": "account",
                            "help": "Cloud Insights account configured on the Configuration page.",
                            "required": true,
                            "options": {
                                "referenceName": "account"
                            },
                            "validators": [
                                {
                                    "type": "regex",
                                    "pattern": "^[a-zA-Z]\\w*$",
                                    "errorMsg": "Select a valid account."
                                },
                                {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 50,
                                    "errorMsg": "Length of Account should be between 1 and 50."
                                }
                            ]
                        },
                        {
                            "type": "text",
                            "label": "Interval",
                            "field": "interval",
                            "required": true,
                            "defaultValue": "300",
                            "help": "How often to poll, in seconds (60 to 86400). Each run ingests alerts that are new or changed since the last run.",
                            "validators": [
                                {
                                    "type": "number",
                                    "range": [
                                        60,
                                        86400
                                    ],
                                    "isInteger": true,
                                    "errorMsg": "Interval must be an integer between 60 and 86400 seconds."
                                }
                            ]
                        },
                        {
                            "type": "singleSelect",
                            "label": "Index",
                            "field": "index",
                            "required": true,
                            "defaultValue": "default",
                            "options": {
                                "endpointUrl": "data/indexes",
                                "denyList": "^_.*$",
                                "createSearchChoice": true
                            },
                            "validators": [
                                {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 80,
                                    "errorMsg": "Length of index name should be between 1 and 80."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    },
    "meta": {
        "name": "TA-netapp_cloud_insights_secure",
        "restRoot": "TA_netapp_cloud_insights_secure",
        "version": "1.1.1",
        "displayName": "Workload Security Alerts Add-on for NetApp Cloud Insights",
        "schemaVersion": "0.0.10",
        "supportedPythonVersion": [
            "3.9",
            "3.13"
        ],
        "supportedThemes": [
            "light",
            "dark"
        ]
    }
}
